# Copy to .dlt/secrets.toml (never committed) and fill in. One section per source; each thread adds its
# keys here with a placeholder and a note on where to get the value. Values are read by dlt as
# `dlt.secrets[...]`; environment variables work too (SOURCES__META_ADS__ACCESS_TOKEN=...).

[destination.clickhouse.credentials]
# The `pipeline` ClickHouse user from sql/00_02_users.sql. dlt loads into the `raw` database.
database = "raw"
username = "pipeline"
password = "pipeline-dev-password"     # OMW_PIPELINE_PASSWORD in .env
host = "127.0.0.1"
port = 9000                            # native protocol (OMW_CLICKHOUSE_NATIVE_PORT)
http_port = 8123                       # OMW_CLICKHOUSE_HTTP_PORT
secure = 0

[sources.meta_ads]
# System-user token from Meta Business Settings > System users > Generate token, with ads_read on the
# ad accounts. Record its expiry: the sync warns 7 days ahead and refuses to run once it has lapsed
# (DESIGN.md §5), so the freshness check fails instead of the data going silently stale.
access_token = "EAAB..."
account_ids = ["000000000000000"]        # ad account ids without the act_ prefix
token_expires_at = "2027-01-01"          # ISO date; leave empty for a non-expiring system-user token
levels = ["campaign"]                    # insights levels: campaign (default) and/or ad (live ad sets only)
# breakdowns = ["age_gender", "countries", "placements"]   # campaign-level breakdown presets, each its own table
# leads = true                           # lead-ads submissions per ad; the token also needs leads_retrieval

[sources.google_ads]
# Google Ads API (README "Google Ads access"): developer token from the manager account's API Center,
# an OAuth desktop/web client in Google Cloud and a refresh token for a user who can see the accounts.
# login_customer_id = the manager (MCC) account; customer_ids = the client accounts to load. No dashes.
developer_token = ""
client_id = ""
client_secret = ""
refresh_token = ""
login_customer_id = "0000000000"
customer_ids = ["0000000000"]
# api_version = "v22"                 # bump when Google sunsets the pinned version (omw.sources.google_ads.client)

[sources.ga4]
# Service-account JSON (Google Cloud > IAM > Service accounts > Keys) with the Google Analytics Data API
# enabled on the project. Add the service account's email as a Viewer on each property in
# GA4 Admin > Property access management. Numeric property ids (Admin > Property details).
property_ids = ["000000000"]
credentials_path = "/path/to/ga4-service-account.json"

[sources.search_console]
# Service-account JSON (Google Cloud > IAM > Service accounts > Keys) with the Search Console API enabled on
# the project. Add the service account's email as a user (Full or Restricted) on each property in
# Search Console > Settings > Users and permissions; see README "Search Console access".
site_urls = ["sc-domain:example.com"]        # as Search Console names them: sc-domain:... or https://.../
credentials_path = "/path/to/search-console-service-account.json"
search_types = ["web"]                       # also: image, video, news, discover, googleNews
data_state = "all"                           # "all" includes the fresh 2-3 days; "final" waits for them

[sources.linkedin_ads]
# A LinkedIn developer app with Advertising API access (README "LinkedIn Ads access": the app must be
# approved by LinkedIn and tied to an ad account), its client id/secret, and a refresh token from the
# 3-legged OAuth flow with the r_ads and r_ads_reporting scopes. Refresh tokens last a year.
client_id = ""
client_secret = ""
refresh_token = ""
account_ids = ["000000000"]            # sponsored account ids (digits of urn:li:sponsoredAccount)
# leads = true                         # lead-gen form responses; the token also needs r_marketing_leadgen_automation

[sources.twenty]
# Twenty CRM (README "Twenty access"): the self-hosted instance URL without a trailing slash and an
# API key from Settings > Developers. Attribution is read from optional custom fields named
# campaignKey, utmSource, utmMedium and utmCampaign on companies, people and opportunities.
base_url = "https://twenty.example.com"
api_key = ""

[sources.stripe]
# Restricted key (Developers > API keys > Create restricted key) with read access to Customers,
# Subscriptions, Invoices and Balance transactions. Attribution metadata (campaign_key, utm_source,
# utm_medium, utm_campaign) is read from the metadata of those objects when the sign-up flow sets it.
api_key = "rk_live_..."
# invoice_window_days = 90             # invoices created in this window are re-fetched and merged
