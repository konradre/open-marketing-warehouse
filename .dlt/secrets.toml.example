# Copy to .dlt/secrets.toml (never committed) and fill in. One section per source; each thread adds its
# keys here with a placeholder and a note on where to get the value. Values are read by dlt as
# `dlt.secrets[...]`; environment variables work too (SOURCES__META_ADS__ACCESS_TOKEN=...).

[destination.clickhouse.credentials]
# The `pipeline` ClickHouse user from sql/00_02_users.sql. dlt loads into the `raw` database.
database = "raw"
username = "pipeline"
password = "pipeline-dev-password"     # OMW_PIPELINE_PASSWORD in .env
host = "127.0.0.1"
port = 9000                            # native protocol (OMW_CLICKHOUSE_NATIVE_PORT)
http_port = 8123                       # OMW_CLICKHOUSE_HTTP_PORT
secure = 0

[sources.meta_ads]
# System-user token from Meta Business Settings > System users > Generate token (ads_read).
# Note its expiry; the freshness check fails when it lapses (DESIGN.md §5).
access_token = "EAAB..."
account_ids = ["act_000000000000000"]
# token_expires_at = "2027-01-01"      # optional, ISO date

[sources.google_ads]
# Google Ads API: developer token from the API Center, OAuth client + refresh token for a user with
# access to the accounts. Login customer id = the MCC, without dashes.
developer_token = ""
client_id = ""
client_secret = ""
refresh_token = ""
login_customer_id = "0000000000"
customer_ids = ["0000000000"]

[sources.ga4]
# Service-account JSON (Google Cloud > IAM > Service accounts) added as a Viewer on the GA4 property.
property_ids = ["000000000"]
credentials_path = "/path/to/ga4-service-account.json"

[sources.search_console]
# Service-account JSON added as a user on each property in Search Console > Settings > Users.
site_urls = ["sc-domain:example.com"]
credentials_path = "/path/to/search-console-service-account.json"

[sources.linkedin_ads]
# OAuth app approved for the Advertising API; refresh token from the 3-legged flow.
client_id = ""
client_secret = ""
refresh_token = ""
account_ids = ["000000000"]

[sources.twenty]
# Twenty CRM: Settings > Developers > API keys. Self-hosted base URL without a trailing slash.
base_url = "https://twenty.example.com"
api_key = ""

[sources.stripe]
# Restricted key with read access to Customers, Subscriptions, Invoices, Charges, Balance transactions.
api_key = "rk_live_..."
