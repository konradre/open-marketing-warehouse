# Copy to .env (never committed). Compose reads it through `make up` (docker compose --env-file .env);
# the tests read it too. Everything here has a laptop-only dev default in deploy/docker-compose.yml.

# ---- warehouse (always on) ----
# ClickHouse `admin`: full access, used to bootstrap and to run migrations. Not used by the agent.
OMW_ADMIN_PASSWORD=admin-dev-password
# ClickHouse `pipeline`: dlt writes raw and ops, maintains marts.
OMW_PIPELINE_PASSWORD=pipeline-dev-password
# ClickHouse `agent`: SELECT on marts.* and ops.freshness, profile + quota from sql/00_*.sql.
OMW_AGENT_PASSWORD=agent-dev-password
# Bearer token clients send to mcp-clickhouse (Authorization: Bearer ...). `openssl rand -hex 32`.
OMW_MCP_AUTH_TOKEN=mcp-dev-token
# Host ports (all bound to 127.0.0.1).
OMW_CLICKHOUSE_HTTP_PORT=8123
OMW_CLICKHOUSE_NATIVE_PORT=9000
OMW_MCP_PORT=8000

# ---- tests ----
# Where the integration tests find the stack. Set OMW_REQUIRE_CLICKHOUSE=1 (CI does) to fail instead of
# skipping when it is not reachable.
OMW_CLICKHOUSE_HOST=127.0.0.1
OMW_MCP_URL=http://127.0.0.1:8000/mcp
# OMW_REQUIRE_CLICKHOUSE=1

# ---- profile: chat (LibreChat) — `make chat` ----
OMW_CHAT_PORT=3080
LIBRECHAT_ALLOW_REGISTRATION=true
# Generate each with `openssl rand -hex 32` (CREDS_IV: `openssl rand -hex 16`).
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
# Model provider keys for the chat UI (optional).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- profile: observability (Langfuse) — `make observability` ----
OMW_LANGFUSE_PORT=3000
OMW_LANGFUSE_MINIO_PORT=9090
# Generate each with `openssl rand -hex 32`.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
