[Unit]
Description=open-marketing-warehouse: backup_verify (sun 06:30 UTC, restore drill: the newest backup into scratch databases)

[Timer]
OnCalendar=Sun *-*-* 06:30:00 UTC
Persistent=true
Unit=omw-sync@backup_verify.service

[Install]
WantedBy=timers.target
