<!-- Single-node settings for the warehouse container. The image's own docker_related_config.xml already
     listens on all container interfaces; compose binds the published ports to localhost only. -->
<clickhouse>
    <!-- The server's own log files, rotated by size: at most 5 x 50 MB each for the log and the error log. -->
    <logger>
        <level>warning</level>
        <size>50M</size>
        <count>5</count>
    </logger>
    <!-- Keep the server inside the container's memory: 80% of what cgroups allow. -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>

    <!-- Where `omw backup` writes (BACKUP ... TO Disk('backups', ...)): the `clickhouse-backups` volume, a
         disk of its own so a backup can be copied off the host without touching the data directory. The
         image's entrypoint creates the path and gives it to the clickhouse user. -->
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/backups/</path>
            </backups>
        </disks>
    </storage_configuration>
    <backups>
        <allowed_disk>backups</allowed_disk>
        <allowed_path>/backups/</allowed_path>
    </backups>

    <!-- The server's log tables grow without bound by default. Keep 30 days of each; a small host cannot
         afford more, and nothing in this repo reads them. -->
    <query_log replace="1">
        <database>system</database>
        <table>query_log</table>
        <engine>ENGINE = MergeTree PARTITION BY toYYYYMM(event_date) ORDER BY (event_date, event_time) TTL event_date + INTERVAL 30 DAY DELETE</engine>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
    <part_log replace="1">
        <database>system</database>
        <table>part_log</table>
        <engine>ENGINE = MergeTree PARTITION BY toYYYYMM(event_date) ORDER BY (event_date, event_time) TTL event_date + INTERVAL 30 DAY DELETE</engine>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </part_log>
    <backup_log replace="1">
        <database>system</database>
        <table>backup_log</table>
        <engine>ENGINE = MergeTree PARTITION BY toYYYYMM(event_date) ORDER BY (event_date, event_time_microseconds) TTL event_date + INTERVAL 400 DAY DELETE</engine>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </backup_log>
    <!-- High-volume diagnostics nobody reads on a single node: off. -->
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_metric_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <query_views_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <blob_storage_log remove="1"/>
    <zookeeper_log remove="1"/>
</clickhouse>
